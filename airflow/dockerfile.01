FROM apache/airflow:2.7.3-python3.10

USER root

# Install Java 11
RUN apt-get update \
  && apt-get install -y openjdk-11-jdk curl \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set environment variables for Java
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

# Install Spark 3.3.1
ENV SPARK_HOME=/opt/spark
ENV SPARK_VERSION=3.3.1
RUN curl -L https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz | \
    tar -xz -C /opt/ && \
    mv /opt/spark-${SPARK_VERSION}-bin-hadoop3 $SPARK_HOME

ENV PATH=$SPARK_HOME/bin:$SPARK_HOME/sbin:$PATH
ENV PYSPARK_PYTHON=python3

# Add PostgreSQL JDBC JAR
ENV SPARK_JARS_DIR=$SPARK_HOME/jars
RUN curl -L -o $SPARK_JARS_DIR/postgresql-42.6.0.jar https://jdbc.postgresql.org/download/postgresql-42.6.0.jar

USER airflow

# Install Spark provider
RUN pip install --no-cache-dir apache-airflow-providers-apache-spark==4.1.1
